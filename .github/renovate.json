{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "enabledManagers": [
    "tflint-plugin",
    "terraform-version"
  ],
  "packageRules": [
    {
      "matchManagers": ["tflint-plugin"],
      "groupName": "tflint plugins",
      "labels": ["tflint", "dependencies"]
    },
    {
      "matchManagers": ["terraform-version"],
      "groupName": "Terraform",
      "labels": ["terraform", "dependencies"]
    }
  ]
}
